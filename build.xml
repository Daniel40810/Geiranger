    <!--
        Phase 1: Isolationsprüfung der Element-Packages (Paketvertrag Punkt 9). Jedes Package unter src/com/dan
        außer der App (in Geiranger seit Phase 18 aus pakete/: fall und cliff, die auch in lib/Renderer.jar liegen) wird für sich allein
        übersetzt: Kern nur gegen das JDK, gl/ gegen JOGL, demo/ gegen FStyle. Läuft nach jedem Übersetzen; abschalten
        mit -Dohne.paketpruefung=true.
    -->
    <target name="check-packages" description="Übersetzt jedes Element-Package einzeln gegen JDK, JOGL und FStyle." unless="ohne.paketpruefung">
        <property name="platform.java" value="java"/>
        <exec executable="${platform.java}" dir="${basedir}" failonerror="true">
            <arg value="-Dstdout.encoding=UTF-8"/>
            <arg value="-Dstderr.encoding=UTF-8"/>
            <arg value="tools/PaketPruefung.java"/>
            <arg value="pakete"/>
            <arg value="lib"/>
        </exec>
    </target>
    <target name="-post-compile" depends="check-packages"/>

    <!-- Phase 18: fall und cliff liegen in lib/Renderer.jar. Ihre Quellen stehen in pakete/ (nicht im Quellbaum der App);
         nach einer Änderung dort baut dieses Target sie neu und frischt Renderer.jar auf (Klassen, Shader, README). -->
    <target name="renderer-jar" description="Phase 18: übersetzt pakete/ (fall, cliff) für Java 21 und frischt lib/Renderer.jar damit auf.">
        <delete dir="build/pakete"/>
        <mkdir dir="build/pakete"/>
        <javac srcdir="pakete" destdir="build/pakete" release="21" encoding="UTF-8" includeantruntime="false" debug="true">
            <classpath>
                <pathelement location="lib/jogl-all.jar"/>
                <pathelement location="lib/gluegen-rt.jar"/>
                <pathelement location="lib/FStyle.jar"/>
            </classpath>
        </javac>
        <copy todir="build/pakete">
            <fileset dir="pakete" excludes="**/*.java"/>
        </copy>
        <jar destfile="lib/Renderer.jar" update="true" basedir="build/pakete"/>
        <echo message="lib/Renderer.jar mit fall und cliff aus pakete/ aufgefrischt"/>
    </target>

