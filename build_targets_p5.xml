        <java classname="com.dan.geiranger.tools.Tempo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
